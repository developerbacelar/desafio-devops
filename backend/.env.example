# Chave da API do Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=SUA_API_KEY_AQUI

# Modelo usado nas respostas
GEMINI_MODEL=gemini-flash-latest

# Chave da API do Groq (https://console.groq.com/keys) - usada como fallback
# automatico quando a chamada ao Gemini falhar. Deixe vazio para desativar o fallback.
GROQ_API_KEY=SUA_API_KEY_AQUI

# Modelo usado no fallback do Groq
GROQ_MODEL=llama-3.3-70b-versatile

# Porta do servidor
PORT=3333

# Conexao com o PostgreSQL (Neon, Supabase ou Docker local)
# Opcional no Sprint 1: sem ela a API usa a empresa padrao em memoria
DATABASE_URL=postgresql://chatbot:chatbot@localhost:5432/chatbot

# Credenciais do admin unico do painel (Sprint 3)
# Gere o hash com: node -e "console.log(require('bcryptjs').hashSync('SUA_SENHA_AQUI', 10))"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=SUA_HASH_AQUI

# Segredo para assinar os tokens JWT (Sprint 3)
JWT_SECRET=SUA_SECRET_AQUI
